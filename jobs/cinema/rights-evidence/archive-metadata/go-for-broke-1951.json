ce": "derivative", "format": "512Kb MPEG4", "original": "Go_for_Broke.avi", "md5": "c86b848a046bcaee104f814a7788ed11", "mtime": "1227617110", "size": "393496410", "crc32": "956adfaa", "sha1": "6a6d5dfdfafb2ca14d17d291bc880beaaa6d3869", "length": "5420.1", "height": "240", "width": "312"}, {"name": "Go_for_Broke_archive.torrent", "source": "metadata", "btih": "f6d8adedd664147e444b3d0e8c8fcc0da53ea7a2", "mtime": "1762231983", "size": "42047", "md5": "4fcfd5f5daba6b4f1450ecf141c10eb1", "crc32": "12b3b104", "sha1": "43200d8f469e8c4e824dd300ea03bcb30e0bc5d7", "format": "Archive BitTorrent"}, {"name": "Go_for_Broke_files.xml", "source": "metadata", "format": "Metadata", "md5": "719861883683abcda1f361ed57c37583", "summation": "md5"}, {"name": "Go_for_Broke_meta.xml", "source": "metadata", "format": "Metadata", "mtime": "1762231973", "size": "1673", "md5": "630f307378650d03e38965b92521067f", "crc32": "67adbcd5", "sha1": "30a664c4b0836b50033bc60856f8927ae2734147"}, {"name": "Go_for_Broke_reviews.xml", "source": "metadata", "format": "Metadata", "mtime": "1568440542", "size": "2164", "md5": "c78a23576b88745b3c9df34990efaf22", "crc32": "6344993a", "sha1": "bd109ac90f8bbf6f1ab855a551204a0f1935d50d"}, {"name": "__ia_thumb.jpg", "source": "original", "mtime": "1762231973", "size": "10025", "md5": "c69b7c5cc8989552a0ada2779e3abb13", "crc32": "619b2b23", "sha1": "a7cecb738bc78e9ea444779b0cdbe6ef94b64fa9", "format": "Item Tile", "rotation": "0"}], "files_count": 101, "item_last_updated": 1762231983, "item_size": 2082957937, "metadata": {"identifier": "Go_for_Broke", "title": "Go for Broke!", "creator": "Dore Schary", "mediatype": "movies", "collection": ["feature_films_unsorted", "feature_films", "moviesandfilms"], "description": "The film dramatizes the real-life story of the 442nd Regimental Combat Team, which was composed of Nisei, second-generation Americans born of Japanese parents. \nFighting in the European theater during World War II, this unit became the most heavily decorated unit for its size and length of service in the history of the United States Army. As well as one of the units with the highest casualty rates.", "date": "1951", "year": "1951", "subject": "Drama; War", "licenseurl": "http://creativecommons.org/licenses/publicdomain/", "publicdate": "2008-03-12 19:14:03", "addeddate": "2008-03-12 18:31:35", "uploader": "josef_schrantz@freenet.de", "updater": ["k-otic", "k-otic", "twainbough"], "updatedate": ["2008-03-12 19:19:21", "2008-03-13 14:23:14", "2008-03-14 22:13:24"], "sponsor": "k-otic.com", "director": "Robert Pirosh", "publisher": "Metro-Goldwyn-Mayer", "sound": "sound", "color": "black & white", "runtime": "92 min", "contact": "www.k-otic.com", "backup_location": "ia903601_26", "collection_added": ["feature_films", "moviesandfilms"]}, "reviews": [{"reviewbody": "Looking forward to seeing this, eventhough the message from FDR was abit of a joke.  The message he give for the press back during WWII and congress; while thousands were in intermet\ncamps (one of them in Arizona).", "reviewtitle": "Go for Broke", "reviewer": "rq52", "reviewdate": "2008-03-14 22:02:57", "createdate": "2008-03-14 22:02:57", "stars": "4"}, {"reviewbody": "that was the last line.\nit was not the proper end.\nthe larger download said it was 62 percent complete.\nthe mp4 was the same ending at 100 percent \nwhat a waste of time", "reviewtitle": "Shipping out to the pacific", "reviewer": "flickfdude", "reviewdate": "2008-03-19 02:24:15", "createdate": "2008-03-19 02:24:15", "stars": "0"}, {"reviewbody": "There can be little doubt that this Hollywood propaganda product was intended to put a smiley face on Japanese internment during WWII. \n\nAmerica\u2019s use and  promotion of negative racial sentiments against \u201cJaps\u201d and Krauts in her \u201cWWII\u201d war effort, stands in contrast to how a \u201cwar\u201d is prosecuted today. Still, it is not a horrible flick as war movies go. \n\nMy favorite part is when the 442nd captures a small outpost. Upon surrender, the bewildered  German officer asks \u201cWhat kind of troops are these, Chinese?  \n\nPresident Harry Truman read the postscript. Hugh Beaumont of \u201cLeave it to Beaver\u201d fame, has a minor role as a priest.\n\nI give this movie 4 stars because the film managed to keep my interest, and because this is my first review. No sense flinging poo about on my first review.", "reviewtitle": "Let's forget all about internment, shall we?", "reviewer": "Kodachrome", "reviewdate": "2010-09-29 09:55:45", "createdate": "2010-09-29 09:55:45", "stars": "4"}], "server": "dn600303.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn600303": {"sys_changed_by": {"source": "task", "task_id": "5417031063"}, "sys_last_changed": "2026-06-04 18:56:19.622045"}}}, "solo": true, "uniq": 1476221899, "workable_servers": ["dn600303.us.archive.org"]}