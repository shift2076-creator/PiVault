25_reviews.xml", "source": "original", "mtime": "1658343794", "size": "1047", "format": "Metadata", "md5": "4b041b730b3f01878fb0daa9ff7c003d", "crc32": "f5f28c64", "sha1": "0d98c1a3f1d8033c1d6737fdf3229f7f7a6facd5"}, {"name": "__ia_thumb.jpg", "source": "original", "mtime": "1657994160", "size": "5003", "md5": "5d299d744a3ed4bcb93aec021230ee16", "crc32": "e2be0ed9", "sha1": "735f0e1b609e24e5c56284601573b7b5794f661d", "format": "Item Tile", "rotation": "0"}], "files_count": 98, "item_last_updated": 1658343799, "item_size": 678319885, "metadata": {"identifier": "TheWizardOfOz1925", "title": "The Wizard Of Oz 1925", "creator": "Larry Semon", "mediatype": "movies", "collection": ["TheVideoCellarCollection", "feature_films", "moviesandfilms"], "description": "Larry Semon's 1925 film of The Wizard Of Oz. Features Oliver Hardy.", "subject": "Larry Semon; Oliver Hardy", "licenseurl": "http://creativecommons.org/publicdomain/mark/1.0/", "publicdate": "2011-10-03 05:47:02", "addeddate": "2011-10-03 04:51:38", "uploader": "video_cellar@yahoo.com.au", "director": "Larry Semon", "sound": "silent", "color": "b/w", "runtime": "1:25:00", "contact": "www.thevideocellar.com", "updatedate": "2011-10-03 07:24:10", "updater": "Video-Cellar", "backup_location": "ia903703_20", "ia_orig__runtime": "85 minutes 0 seconds"}, "reviews": [{"reviewbody": "One hour and twenty-five minutes of Larry Semon slapstick, with any resemblance to the actual Wizard of Oz being purely accidental. Oliver Hardy is on hand and eventually gets to be the Tin Man\u2026 er, sort of. The plot is nonstop whackiness punctuated with daredevil stunts and title cards loaded with outrageous puns. Though dated the many FX are fun and at times even impressive. All in all a fun movie.\n\nWhat seems to be a complete print is in watchable condition. However it is quite dark during many scenes. The brightness controls on the GOM and VLC video players help considerably. There is no audio track.", "reviewtitle": "Wizard of what?", "reviewer": "picfixer", "reviewdate": "2011-10-17 22:12:20", "createdate": "2011-10-17 21:47:55", "stars": "4"}], "server": "dn801202.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn801202": {"sys_changed_by": {"source": "task", "task_id": "5461126587"}, "sys_last_changed": "2026-06-23 11:58:31.288872"}}}, "solo": true, "uniq": 1538857833, "workable_servers": ["dn801202.us.archive.org"]}