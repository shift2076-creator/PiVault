294627", "size": "991", "md5": "9017b9ab502bd4712ea1cfbf1333c97f", "crc32": "bd972b0a", "sha1": "c6a305edf8cf6442f60c666cf5af4782fb158a7b"}, {"name": "__ia_thumb.jpg", "source": "original", "mtime": "1657996226", "size": "4091", "md5": "ceb80798512e2cc9ca81d4483466cf1b", "crc32": "bbd50ce0", "sha1": "3c76cc0634f9fb10429208a65f7b6ad9eca290ea", "format": "Item Tile", "rotation": "0"}], "files_count": 86, "item_last_updated": 1762234319, "item_size": 1843655065, "metadata": {"identifier": "PublicdomainTheLastoftheMohicans", "title": "The Last of the Mohicans", "mediatype": "movies", "collection": ["feature_films_unsorted", "feature_films", "moviesandfilms"], "description": "Adaptation of James Fenimore Cooper novel about the American frontier during the French and Indian War.", "date": "1920", "year": "1920", "licenseurl": "http://creativecommons.org/licenses/publicdomain/", "publicdate": "2006-09-08 17:45:48", "adder": "his_ncp@sbcglobal.net", "uploader": "his_ncp@sbcglobal.net", "updater": ["ARossi", "ARossi"], "updatedate": ["2006-09-13 17:26:29", "2006-09-13 17:39:34"], "sound": "silent film with music soundtrack", "color": "black and white", "resource": "movies", "license": "http://creativecommons.org/licenses/publicdomain/", "format": "Video", "keywords": "Western, Native Americans, French and Indian War", "holder": "Public domain", "backup_location": "ia903600_21", "closed_captioning": "no", "addeddate": "2006-09-08 17:45:48", "collection_added": ["feature_films", "moviesandfilms"]}, "reviews": [{"reviewbody": "There are some films that need to be watched just for their historical value. Such is this silent version of The Last of the Mohicans. Seeing a young Wallace Beery prancing around as Mauga the Indian is worth the download itself. The role of Hawkeye is also worth a gander. Historical accuracy was not the goal of the book, nor is it the goal of the movie. Not many actors transitioned from the silent films to the talkies as well as Wallace Beery. I give it 4 stars for it's historical value, and perhaps 3 stars for its quality as a movie.", "reviewtitle": "Worth Watching", "stars": "4", "reviewer": "b11761500s", "createdate": "2007-02-15 05:16:05", "reviewdate": "2007-02-15 05:16:05"}], "server": "dn601204.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn601204": {"sys_changed_by": {"source": "task", "task_id": "5433309385"}, "sys_last_changed": "2026-06-12 13:14:45.753478"}}}, "solo": true, "uniq": 1270630302, "workable_servers": ["dn601204.us.archive.org"]}