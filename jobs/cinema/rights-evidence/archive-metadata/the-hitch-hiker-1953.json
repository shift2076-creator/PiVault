ime": "1286314874", "crc32": "922dc72b", "sha1": "00720baeb9e94f11c3f51ddfafa9ab31fa4e7594"}, {"name": "Hitch_Hiker_archive.torrent", "source": "metadata", "btih": "8a1c1d7ddd9a150a41bb8ab1f83416249bc14561", "mtime": "1784428011", "size": "30762", "md5": "70e6fb21012fcc53b502d89c0d9ba6f5", "crc32": "6e8b5cdb", "sha1": "d4dbf6a0905fa0b78482b73709a07621d759a3ff", "format": "Archive BitTorrent"}, {"name": "Hitch_Hiker_files.xml", "source": "metadata", "format": "Metadata", "md5": "2920d1e7897fb2d523b24c7782a1ede8", "summation": "md5"}, {"name": "Hitch_Hiker_meta.xml", "source": "metadata", "size": "2264", "format": "Metadata", "mtime": "1541155816", "md5": "d3b3c50f9f093cf623042ca293538aff", "crc32": "2c716d16", "sha1": "f9c52431f86c07b6ec0ae14ba399a80b0e06bc2b"}, {"name": "Hitch_Hiker_reviews.xml", "source": "metadata", "size": "14864", "format": "Metadata", "mtime": "1784862875", "md5": "7de6da6f5e2fb97c1d46b1188ed549c4", "crc32": "104218ae", "sha1": "a5c4226a181c3382d8181361c673ef40f05c8238"}, {"name": "__ia_thumb.jpg", "source": "original", "mtime": "1784428010", "size": "9793", "md5": "57bba563634a937a0f14be51dd11e985", "crc32": "b3ada702", "sha1": "670c14c3b1d486e864b25870c43ff99911a97be9", "format": "Item Tile", "rotation": "0"}], "files_count": 88, "item_last_updated": 1784862876, "item_size": 2745105902, "metadata": {"identifier": "Hitch_Hiker", "title": "The Hitch-Hiker", "mediatype": "movies", "collection": ["Film_Noir", "feature_films", "moviesandfilms"], "description": "<table width=\"95%\" align=\"center\" cellpadding=\"12\"><tr bgcolor=\"#DDDDDD\"><td>\n<font size=\"+1\">Edmond O'Brien and Frank Lovejoy pick up a hitch-hiker (William Talman) who turns out to be an insane escaped convict.\n</font>\n</td>\n</tr></table><p align=\"center\"><img src=\"http://www.archive.org/download/Hitch_Hiker/Hitch-Hiker.jpg\" alt=\"Hitch-Hiker.jpg\" /></p>\nThe mpeg2 file is ready to be loaded into dvdAuthorGUI to create a DVD to watch on your television.", "date": "1953", "year": "1953", "subject": "suspense;terror;hitch-hiker;murder;convict", "licenseurl": "http://creativecommons.org/licenses/publicdomain/", "publicdate": "2008-04-11 17:17:33", "addeddate": "2008-04-11 17:14:38", "uploader": "w_a_x_man@yahoo.com", "updater": ["Moongleam", "twainbough", "jordonz", "Moongleam", "Moongleam", "Moongleam", "Moongleam", "Moongleam", "Moongleam", "Moongleam", "Moongleam"], "updatedate": ["2008-04-11 17:28:18", "2008-04-11 19:57:49", "2008-04-25 21:29:38", "2009-04-06 17:43:58", "2010-05-21 20:22:13", "2010-10-01 14:22:22", "2010-10-01 14:56:49", "2010-10-05 14:13:56", "2010-10-06 14:49:04", "2010-10-22 19:19:30", "2011-10-26 16:37:40"], "director": "Ida Lupino", "publisher": "Filmakers, The", "sound": "sound", "color": "black and white", "runtime": "1:10:45", "backup_location": "ia903601_30", "closed_captioning": "no"}, "reviews": [{"reviewbody": "But the FLV on the FTP page downloaded. It was a good movie.\nThe bad rating is because it wasn't very good resolution.", "reviewtitle": "couldn't download the mpeg", "reviewer": "flickfdude", "reviewdate": "2008-04-27 05:24:38", "createdate": "2008-04-27 05:24:38", "stars": "3"}, {"reviewbody": "I've seen a few hitch-hiker movies lately. The hitcher, both the Rutger Hauer classic and the fairly recent remake. I like this one better. It made for a good lazy Sunday afternoon feature with plenty of suspense and believable actors, even though in one or two places, he plot itself unfolds in either predictable ways or temporarily lifts the veil of illusion. I give it a solid four stars.", "reviewtitle": "Hitchhiker review", "reviewer": "j_james", "reviewdate": "2008-06-15 22:36:43", "createdate": "2008-06-15 22:36:43", "stars": "4"}, {"reviewbody": "Definitely worth a watch.  Even though it was predictable at times... even cheesy, it was good, honest entertainment and quite suspenseful with good acting to boot.", "reviewtitle": "Great!", "reviewer": "jmcorry1", "reviewdate": "2009-04-05 05:59:54", "createdate": "2009-04-05 05:59:54", "stars": "5"}, {"reviewbody": "This is an edge of the seat crime drama (though not my idea of film noir) from ground breaking director/producer Ida Lupino,featuring three stalwarts of the 50's. Special mention to the excellent William Talman who gave a great study in evil.\nThe film has not dated and stands up to anything made today in a similar vein.\nOne to treasure", "reviewtitle": "A milestone", "reviewer": "keygrip", "reviewdate": "2009-08-30 09:03:01", "createdate": "2009-08-30 09:03:01", "stars": "5"}, {"reviewbody": "Here in Portland OR, Perry Mason consistently beats out the local noon news in the ratings.  Honestly, I'm bored of it.  Day in and day out, most performances are phoned in, Burger always loses and is forever arrogant, bumbling and incompetent.\n\nNot here, Lupino is in fine form as a director, and William Talman does a decent job of acting, though his character is still a loser...a very nasty, loser.  Lupino and Young really did their homework, basing the events of the film on the real-life crime spree of Billy Cook.  Though some facts were changed, Emmett Myers is Billy Cook, right down to the deformed eye.  The tension and pacing are great.  It's pretty brightly lit for noir, but what matters is how bleak the atmosphere is.  It's not exactly dark in the desert, though the interiors tend to be darkly lit.  The piece is just about as bleak as you can get.  All in all, with the print quality and sound being absolutely superb, this is a highly overlooked, under-rated gem of a film and worth seeing.", "reviewtitle": "Holy crow!  Hamilton Burger can act!!", "reviewer": "Elric_Dewisant", "reviewdate": "2010-09-20 13:56:17", "createdate": "2010-09-20 13:56:17", "stars": "4"}, {"reviewbody": "Val Lewton fans should watch this movie if only to see the brilliant Nicholas Musuraca cinematography.\n\nMusuraca who worked on Lewtons Cat People(1942),The Seventh Victim(1943)and The Ghost Ship(1943)now uses his skills in broad daylight and on location, something he seldom did on his films with Lewton.", "reviewtitle": "Cinematography by Nicholas Musuraca", "reviewer": "danielps2fan", "reviewdate": "2010-09-30 08:09:46", "createdate": "2010-09-30 08:09:46", "stars": "5"}, {"reviewbody": "The acting was fine, but the story was not plausible and I could not identify with the characters.\n\nPerhaps it is because I find the whole \"victim mentality\" to be abhorrent, but in my world, I would have mocked the villain at the first stop and told him that he didn't have the testicular fortitude to kill me. \n\nI won't be watching this film again.\n\nI hate to give one star just because the story stunk, so I'll give it two.", "reviewtitle": "I thought the plot was dull.", "reviewer": "Kodachrome", "reviewdate": "2010-11-28 07:37:42", "createdate": "2010-11-28 07:37:42", "stars": "2"}, {"reviewbody": "Great movie, with that sense of what really takes to get you stuck to the screen! Great performances, too.", "reviewtitle": "The good old movies!", "reviewer": "admario", "reviewdate": "2011-06-12 12:22:51", "createdate": "2011-06-12 12:22:51", "stars": "5"}, {"reviewbody": "Great Noir!", "reviewtitle": "Awesome Movie!", "reviewer": "jeffzkrazie", "reviewdate": "2011-10-07 03:59:54", "createdate": "2011-10-07 03:59:54", "stars": "5"}, {"reviewbody": "The film is good for it's time", "reviewtitle": "Good", "reviewer": "MalcolmL", "reviewdate": "2011-10-26 03:13:31", "createdate": "2011-10-26 03:13:31", "stars": "3"}, {"reviewbody": "Thanks for the upload. \n\nThis film frankly and powerfully demonstrates the fact that the world isn't a superhero comic or Rambo. People can mess with you -- with anyone reading this -- and get away with it under the right circumstances. That's where the power of The Hitchhiker comes from, as stated in the films prologue title. Perhaps it took a woman to direct a film that deals honestly with this in it's time. No macho would-be heroics here, just emotional, psychological truth.", "reviewtitle": "A good film for any time, actually.", "reviewer": "NoSpillBlood", "reviewdate": "2011-11-11 01:23:08", "createdate": "2011-11-11 01:23:08", "stars": "5"}, {"reviewbody": "I liked this.  It wasn't great, but good.  By the final scene at the water front, I was really expecting the good guy to get it.  Nice twist.  Somewhat predictable, but nicely done.", "reviewtitle": "Not Great But Definitely A Good Movie", "reviewer": "slurryer", "reviewdate": "2011-11-27 01:26:42", "createdate": "2011-11-27 01:26:42", "stars": "3"}, {"reviewbody": "For 1952-53 this is an excellent movie.  Acting and direction (Ida Lupino as the latter) are superb.  The ending a bit anticlimactic, but overall I would recommend this movie.\nProbably worth 4 stars, but I'm giving it 5 because it's tense, plausible, and basically it's very well made.  Edge of the seat film, and I really wondered what would happen next, and how it would turn out.  Barely over an hour, well spent.", "reviewtitle": "Definitely worth a watch", "reviewer": "Kentworth", "reviewdate": "2014-08-30 23:06:34", "createdate": "2014-08-30 23:06:34", "stars": "5"}, {"reviewbody": "Ida Lupino, as director, William Tallman of Perry Mason Fame,  Frank Lovejoy and Edmond O'brien make this a must watch.  Classic 1940 & 50's cars and smultch aplenty make this a gotta see movie.  I particularly was impressed with Lupino's directing; gritty and leading from the romantic to the real.  Worth watching but gets an extra star for artistic class.  Lovejoy and O'brien had been kings of the Noir over the radio waves.", "reviewtitle": "Classic Stuff", "reviewer": "gregorian chambers", "reviewdate": "2014-09-01 01:16:59", "createdate": "2014-09-01 01:16:59", "stars": "4"}, {"reviewbody": "Why do many people add, in praising a film, the phrase \"for its time.\" If it's good, it's good. Ben Hur (silent version 1925), Sunrise (late 20's), Casablanca, The Graduate, On the Waterfront (1954). Clearly, we all know that new technology creates change, in what we watch, eat, listen to, play with, etc., etc. But all these things have intrinsic value, \nwhich transcends considerations of time. Some people just can't watch a black and white film, some can't watch non-digital animation, I suppose. To bad for them. But this doesn't mean that Disney's Snow White is good for its time; it's just good, the same with black and white pics, like Double Indemnity, Brief Encounter, Some Like It Hot, et al.", "reviewtitle": "re Hitchhiker, et al", "reviewer": "brassclams", "reviewdate": "2014-11-21 20:22:38", "createdate": "2014-11-21 20:22:38", "stars": "4"}, {"reviewbody": "Very good. Would have gave it five star if it were a little more to the movie than driving around in a car. I really appreciated the fact that the perp was apprehended, as oppose to being killed. I feel that being incarcerated is worse punishment; although sometimes the death penalty is needed to make an statement that some lives are not worth sparing.", "reviewtitle": "Hitchhiker", "reviewer": "Hakuna Muhimu", "reviewer_itemname": "@hakuna_muhimu", "reviewdate": "2018-02-16 17:37:16", "createdate": "2018-02-16 17:37:16", "stars": "4"}, {"reviewtitle": "Noir In The Desert", "reviewbody": "Ida Lupino (1918 -- 1995) was a renowned film actress who became interested in directing in the 1940s. In 1952, Lupino became the first woman to direct a noir film with this 1953 release, \"The Hitch--Hiker\". Fifty years later, the movie remains the only woman-directed film noir. \"The Hitch-Hiker\" also is unusual in that it is set on lonely desert roads and small towns rather than in the urban areas of New York City or California favored for noir film. The movie has no femme fatale or other sexual interest. All the important characters are men.\n\nThe film is about two long-time friends and blue collar workers, Roy Collins (Edmond O'Brien) and Gil Bowen (Frank Lovejoy) who take a rare fishing trip vacation leaving wives and kids at home for a few days. On the road the pick up a hitch-hiker, Emmett Myers (William Talman) who immediately puts them under a gun. Myers is a serial killer. The opening frames of the movie show him killing an earlier victim. The police have a manhunt across several states. Myers is psychopathic, sadistic, and utterly ruthless. He lacks the use of an eye. He forces Collins and Bowen to drive him to the coast of Mexico where he plans on catching a ferry and making a getaway.\n\nThe plot of the film is predictable, but the movie works in creating dramatic tension. The acting by the three major characters, particularly Talman as the killer, is taut. The story unfolds slowly as the killer forces the men to drive down deserted Mexican roads through small towns and an occasional small store or gas station. The killer forces the men to turn on the radio to learn news about the efforts of the police towards his capture.\n\nBesides the acting, the photography and scenery make \"The Hitch-Hiker\" work. The movie creates a sense of claustrophobia as the car travels alone, with the pair at the point of a gun. The noir component includes the driving and stops at night at desolate places, the flat desert scenery interspersed with mountains, the stops along the way, and the psychology of the killer and his prospective victims. The two men differ about how to react to their desperate situation but ultimately work together. With all its chilling noir elements, the film celebrates the power of friendship. The movie is short at about 73 minutes which allows it to maintain and to develop its focus and intensity.\n\nIn 1998, \"The Hitch-Hiker\" was selected for inclusion in the National Film Registry, an honor awarded to \"culturally, historically, or aesthetically significant\" films. The movie is in the public domain and easily accessible. It was shown as part of a celebration of noir film held in October at the American Film Institute in Washington, D.C. This is an excellent film for those with an interest in film noir.\n\nRobin Friedman", "stars": "4", "reviewer": "Gissinglover", "reviewdate": "2021-10-18 11:09:32", "createdate": "2021-10-18 11:09:32", "reviewer_itemname": "@gissinglover"}, {"reviewtitle": "Timeless", "reviewbody": "Stands the test of time. As fresh today as it will be in 50 years. One of my goto movies made before I was born,", "stars": "5", "reviewer": "Steverz2", "reviewdate": "2022-02-04 18:53:03", "createdate": "2022-02-04 18:53:03", "reviewer_itemname": "@steverz2"}, {"reviewtitle": "Implausible B movie with problematic script", "reviewbody": "I can\u2019t believe so many reviewers gave this a high rating; while the cinematography is good, the plot is ridiculous. Who would pick up a guy like this, first of all, when he looks like a psychopath, particularly when these two guys were on vacation?  \n\nThe ending in particular was weak in the sense that everything falls into place for the pier scene, with everyone expecting Edmund O\u2019Brien to be shot, but to get him there, they have to magically find a saloon in the middle of nowhere, and then find a man who has a brother with a boat, and he has to see the \u201cWanted\u201d poster at just the right time\u2026yeah, sure.  \n\n\n", "stars": "2", "reviewer": "GH3K3", "reviewdate": "2026-07-19 02:26:46", "createdate": "2026-07-19 02:26:46", "reviewer_itemname": "@biggreg3000"}, {"reviewtitle": "Talman gossip", "reviewbody": "Talman was from a wealthy family and got into some kind of trouble with partying or something and got canned from Perry Mason.  Raymond Burr fought hard for his return and eventually got him back on the show. ", "stars": "0", "reviewer": "Sam Retort", "reviewdate": "2026-07-24 03:14:24", "createdate": "2026-07-24 03:14:24", "reviewer_itemname": "@magis_ana"}], "server": "dn600307.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn600307": {"sys_changed_by": {"source": "task", "task_id": "5415330605"}, "sys_last_changed": "2026-06-04 00:53:40.353177"}}}, "solo": true, "uniq": 315218920, "workable_servers": ["dn600307.us.archive.org"]}