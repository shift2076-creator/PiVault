674247", "md5": "b9430ad76bb0c4a2ed262b3bc2d055a7", "crc32": "dcab4c51", "sha1": "82a49eda86df8d2b18aad79054c6d1219b6d395c", "length": "581", "height": "240", "width": "320"}], "files_count": 29, "item_last_updated": 1675640763, "item_size": 223226919, "metadata": {"mediatype": "movies", "title": "Manhatta", "description": "Manhatta is a A portrait of New York by painter Charles Sheeler and photographer Paul Strand. The title cards show quotes from Walt Whitman's \"Leaves of Grass\". Listed as Public Domain by Wikipedia. \"The film spans an imaginary day in the life of New York City, beginning with footage of Staten Island ferry commuters and culminating with the sun setting over the Hudson River. It has been described as the first avant-garde film made in America... It may be found elsewhewre on the Archive but I have added a jazz track from the period. ", "subject": "silents; New York; documentary", "runtime": "9:41", "sound": "sound", "licenseurl": "http://creativecommons.org/publicdomain/zero/1.0/", "identifier": "Manhatta", "uploader": "alseye@gmail.com", "addeddate": "2010-12-03 01:23:42", "publicdate": "2010-12-03 01:47:03", "backup_location": "ia903607_23", "ia_orig__runtime": "9 minutes 41 seconds", "collection": ["silent_films", "short_films", "feature_films", "moviesandfilms"]}, "reviews": [{"reviewbody": "interesting ", "reviewtitle": "..", "reviewer": "Suziee", "reviewdate": "2013-03-27 08:50:47", "createdate": "2013-03-27 08:50:47", "stars": "3"}], "server": "dn600209.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn600209": {"sys_changed_by": {"source": "task", "task_id": "5415110439"}, "sys_last_changed": "2026-06-03 22:46:18.959264"}}}, "solo": true, "uniq": 541844437, "workable_servers": ["dn600209.us.archive.org"]}