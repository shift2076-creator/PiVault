ificant.\"</span><br style=\"font-family:Arial, Helvetica, sans-serif;font-size:small;\" /></p><div style=\"color:rgb(34,34,34);font-family:Arial, Helvetica, sans-serif;font-size:small;\"><br /></div><div style=\"color:rgb(34,34,34);font-family:Arial, Helvetica, sans-serif;font-size:small;\">Directed by\tBuster Keaton<br />Produced by\tJoseph M. Schenck<br />Written by\tClyde Bruckman,\u00a0Jean Havez,\u00a0Joseph A. Mitchell<br />Starring: Buster Keaton</div><div style=\"color:rgb(34,34,34);font-family:Arial, Helvetica, sans-serif;font-size:small;\">Music by\tClub Foot Orchestra, Beth Custer, Myles Boysen, Steve Kirk, Nik Phelps, Sheldon Brownl<br />Cinematography: Byron Houck,\u00a0Elgin Lessley<br />Edited by\tBuster Keaton<br />Production\u00a0company:\u00a0Metro Pictures Corporation<br />Distributed by\tMetro-Goldwyn Pictures<br />Release date:\u00a0April 21, 1924</div>", "licenseurl": "http://creativecommons.org/publicdomain/mark/1.0/", "scanner": "Internet Archive HTML5 Uploader 1.6.4", "subject": ["slient film", "silent movie", "buster keaton", "sherlock jr."], "title": "Sherlock Jr. 1924", "publicdate": "2019-09-10 14:10:40", "uploader": "jeanlinn@gmail.com", "addeddate": "2019-09-10 14:10:40", "curation": "[curator]validator@archive.org[/curator][date]20190910141132[/date][comment]checked for malware[/comment]", "year": "1924", "sound": "sound", "color": "color", "backup_location": "ia907000_25"}, "reviews": [{"reviewtitle": "how i feel", "reviewbody": "I love it.Made me cry", "stars": "5", "reviewer": "hershy", "reviewdate": "2021-02-24 15:19:59", "createdate": "2021-02-24 15:19:59", "reviewer_itemname": "@hershy"}], "server": "dn800200.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn800200": {"sys_changed_by": {"source": "task", "task_id": "5411259571"}, "sys_last_changed": "2026-06-02 11:54:42.850116"}}}, "solo": true, "uniq": 1952898529, "workable_servers": ["dn800200.us.archive.org"]}