ff", "crc32": "6dbd2480", "sha1": "f54bbd66f43d1d403873dfab9edffd70ae542594", "format": "Metadata"}], "files_count": 26, "item_last_updated": 1792510664, "item_size": 1196402081, "metadata": {"identifier": "steamboat-willie_1928", "actor": "Walt Disney", "collection": ["Comedy_Films", "feature_films", "moviesandfilms"], "coverage": "USA", "creator": ["Ub Iwerks", "Walt Disney"], "date": "1928-11-18", "genre": ["Animation", "Short", "Comedy", "Family", "Musical"], "language": "English", "mediatype": "movies", "scanner": "Internet Archive Python library 3.0.2", "subject": ["Animation", "Short", "Comedy", "Family", "Musical"], "title": "Steamboat Willie", "uploader": "arkiver@archive.org", "publicdate": "2024-01-02 06:55:17", "addeddate": "2024-01-02 08:30:42", "temp-fix-audio": "true", "collection_added": ["feature_films", "moviesandfilms"]}, "reviews": [{"reviewtitle": "No audio", "reviewbody": "Too bad the audio is missing.", "stars": "1", "reviewer": "dtmp", "reviewdate": "2024-01-03 02:42:27", "createdate": "2024-01-03 02:42:27", "reviewer_itemname": "@dtmp"}, {"reviewtitle": "Audio fixed", "reviewbody": "Thank you for the report, the audio should be fixed now.", "stars": "0", "reviewer": "arkiver2", "reviewdate": "2024-01-04 11:20:11", "createdate": "2024-01-04 11:20:11", "reviewer_itemname": "@arkiver2"}, {"reviewtitle": "An absolute classic", "reviewbody": "Mickey decides to show off for his new girlfriend and turn some innocent and unwilling farm animals into musical instruments by sadistically torturing them and making music from their agonized screams. Mikey's appears delighted to brutalize the animals and his sadistic cruelty knows no boundaries; what he does to the pig alone should have landed him in jail or at least on a predator list. The animals are clearly not enjoying themselves and Pete, who is usually the villain, investigates the noise and puts a stop to Mickey's brutal rampage. Mickey is justifiably locked up and forced to peel potatoes but somehow gets to perform one last spiteful act of cruelty on an animal who stupidly celebrates Mickey's incarceration though a nearby porthole. \n", "stars": "5", "reviewer": "alkazar", "reviewdate": "2024-01-11 04:43:49", "createdate": "2024-01-11 04:43:49", "reviewer_itemname": "@alkazar"}, {"reviewtitle": "Homosexual mouse", "reviewbody": "Homosexual mouse", "stars": "5", "reviewer": "fake name683", "reviewdate": "2024-03-07 16:34:51", "createdate": "2024-03-07 16:34:51", "reviewer_itemname": "@fake_name683"}, {"reviewtitle": "Rock your Research podcasts?", "reviewbody": "Hi arkiver2,\n\nSorry this is not related to the Steamboat Willie movie, but I'm wondering if it's possible to re-upload the Rock your Research podcast episodes you previously posted.  The archive is empty.\n\nMany thanks", "stars": "0", "reviewer": "budgntly", "reviewdate": "2024-03-18 16:26:52", "createdate": "2024-03-18 16:26:52", "reviewer_itemname": "@budgntly"}, {"reviewtitle": "PUBLIC DOMAIN MOUSE", "reviewbody": "it is our mission to put the words \"public domain mouse\" in all caps from now on on all uploads of steamboat Willie EVER. anybody with me?", "stars": "5", "reviewer": "cyberspere", "reviewdate": "2024-04-08 23:22:42", "createdate": "2024-04-08 23:22:42", "reviewer_itemname": "@cyberspere"}, {"reviewtitle": "Mabel podcast uploads", "reviewbody": "Hi there, similarly to budgntly sorry to bug you about different uploads on this post - I used to access episodes of Mabel uploaded on this account (https://archive.org/details/podcast_mabel_1160860118), but I can no longer access the links due to the collection being restricted, I think? Would it possible for you to un-restrict the collection or otherwise provide access to these files (privately if needed)? Thanks so much. ", "stars": "0", "reviewer": "buttonsandhorseshoes", "reviewdate": "2024-06-08 09:26:54", "createdate": "2024-06-08 09:26:54", "reviewer_itemname": "@buttonsandhorseshoes"}, {"reviewtitle": "mOuSe", "reviewbody": "2 year old spelling: mokey be steering da weel den Peet wuntehd 2 bi  cahptehn. My spelling: Mickey be steering the wheel then Pete wanted to be Captain.", "stars": "5", "reviewer": "ThatOneSpongeBoi", "reviewdate": "2024-06-13 17:48:27", "createdate": "2024-06-13 17:48:27", "reviewer_itemname": "@mjfan58"}, {"reviewtitle": "Now I have a copy of it \ud83d\ude03", "reviewbody": "Yay", "stars": "0", "reviewer": "Jayce pimentel", "reviewdate": "2025-11-20 12:50:19", "createdate": "2025-11-20 12:50:19", "reviewer_itemname": "@jayce_pimentel"}, {"reviewtitle": "Anima\u00e7\u00e3o legal", "reviewbody": "Muito bom mesmos esse anima\u00e7\u00e3o tem erro de  continuidade mais continua muito bom\ud83d\ude0a", "stars": "4", "reviewer": "B I A T R I Z \u0c8c", "reviewdate": "2025-12-26 06:01:19", "createdate": "2025-12-26 06:01:19", "reviewer_itemname": "@b_i_a_t_r_i_z_"}, {"reviewtitle": "None", "reviewbody": "Ah, the feeling of public domain!", "stars": "5", "reviewer": "Randomusahr", "reviewdate": "2026-01-02 22:28:10", "createdate": "2026-01-02 22:28:10", "reviewer_itemname": "@randomusahr"}, {"reviewtitle": "This Was Fantabulous!!!!!", "reviewbody": "I remembered this short cartoon like it was 100 years ago.", "stars": "5", "reviewer": "EricTheCupheadAndHazbinHotelFan Archive", "reviewdate": "2026-09-26 21:43:48", "createdate": "2026-09-26 21:43:48", "reviewer_itemname": "@eric_kun"}, {"reviewtitle": "awesome", "reviewbody": "it was funny and really is comedy but somehow felt like an hour\n", "stars": "5", "reviewer": "Jovany Salazar", "reviewdate": "2026-10-20 15:37:18", "createdate": "2026-10-20 15:37:18", "reviewer_itemname": "@jovany_salazar"}], "server": "dn800306.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn800306": {"sys_changed_by": {"source": "task", "task_id": "5422869511"}, "sys_last_changed": "2026-06-07 09:45:45.436555"}}}, "solo": true, "uniq": 1822901411, "workable_servers": ["dn800306.us.archive.org"]}