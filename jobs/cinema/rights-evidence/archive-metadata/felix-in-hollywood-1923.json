Metadata", "md5": "ab3402269ccd65541852023c1355579f", "summation": "md5"}, {"name": "Felix_inHollywood_NoAudio_meta.xml", "source": "metadata", "format": "Metadata", "mtime": "1771008752", "size": "1566", "md5": "e7af6ca251e5e847b09450a7e2b03661", "crc32": "d593c459", "sha1": "4b990b57acafcc862afbb5db0a82fc79484087d8"}, {"name": "Felix_inHollywood_NoAudio_reviews.xml", "source": "metadata", "format": "Metadata", "mtime": "1290412642", "size": "1230", "md5": "a15b8cb2259b83a6ed62de0d0e5aeb87", "crc32": "f7e856ca", "sha1": "eb8e67fd2a96aa9ee218af54fcee9cd362a644a3"}, {"name": "__ia_thumb.jpg", "source": "original", "mtime": "1711266573", "size": "8359", "md5": "75c63322c27a493224bdcfe9d98331b0", "crc32": "7ea24a8c", "sha1": "0ad381a71bbc90f537df7df7a61d7529ebe68367", "format": "Item Tile"}], "files_count": 33, "item_last_updated": 1771008752, "item_size": 339329771, "metadata": {"identifier": "Felix_inHollywood_NoAudio", "title": "Felix in Hollywood", "creator": "M.J. Winkler", "mediatype": "movies", "collection": ["more_animation", "animationandcartoons"], "description": "A struggling (and starving) actor finally relents and agrees to go to Hollywood to be in films. But first, Felix has to find a way to raise the money to get Felix and his master (the actor) there.\n\nYou can find more information regarding this film on <a href=\"http://www.imdb.com/title/tt0017871/\" rel=\"ugc nofollow\">its IMDb page</a>.", "date": "1923", "year": "1923", "subject": "Classic cartoon; 1920s; Felix", "licenseurl": "http://creativecommons.org/licenses/publicdomain/", "publicdate": "2006-01-29 19:42:36", "addeddate": "2006-01-30 03:42:33", "uploader": "archiverrichard-august@yahoo.com", "updater": ["richardsur", "ARossi"], "updatedate": ["2006-01-29 19:50:28", "2008-02-07 21:31:53"], "director": "Pat Sullivan", "sound": "silent", "color": "black and white", "runtime": "4:27", "credits": "M.J. Winkler presents\nFelix in Hollywood\nA Pat Sullivan Comic\nCopyright 1923\n\nFrom Kodascope Libraries\n\nFrom\nFelix in Hollywood\nKodascope Libraries", "rights": "Copyright 1923 (expired)", "language": "English", "backup_location": "ia903600_12"}, "reviews": [{"reviewbody": "Felix gets money for his owner to go to Hollywood by helping a bankrupt shoe store owner to sell his shoes by dropping wads of gum all over the street, so that people will get their shoes stuck in them. His owner, the ingrate, announces that Felix will have to stay home while he goes to Hollywood, so Felix masquerades as the man\u2019s carpetbag so he will get taken along. In Hollywood, he meets animated versions of various silent screen stars, such as Charlie Chaplin and Ben Turpin, and gets his big break by helping a guy who was being tormented by some vicious mosquitoes. Again, this is a wonderfully weird, fun Felix, with shapeshifting and star cameos to boot.\nRatings: Camp/Humor Value: ****. Weirdness: *****. Historical Interest: *****. Overall Rating: *****.", "reviewtitle": "That Carpetbagging Felix!", "stars": "5", "reviewer": "Christine Hennig", "createdate": "2007-02-04 03:40:07", "reviewdate": "2007-02-04 03:40:07"}], "server": "dn800300.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn800300": {"sys_changed_by": {"source": "task", "task_id": "5457965429"}, "sys_last_changed": "2026-06-22 05:40:50.050232"}}}, "solo": true, "uniq": 2081796215, "workable_servers": ["dn800300.us.archive.org"]}