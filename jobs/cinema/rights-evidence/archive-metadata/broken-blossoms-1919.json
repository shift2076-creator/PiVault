erivative", "format": "Animated GIF", "original": "Broken_Blossoms.mp4", "md5": "c26c538e3c317117a914710b7dcf90cb", "mtime": "1267714657", "size": "299941", "crc32": "550f1ccc", "sha1": "bec2eacda70101317ae21b3ee7d5fe98f32d00d1"}, {"name": "Broken_Blossoms.mp4", "source": "original", "format": "MPEG4", "title": "Broken Blossoms", "md5": "3c7d826c7d3c89df7940ce6373ed1897", "mtime": "1267713360", "size": "426837856", "crc32": "23b4e7a8", "sha1": "f02206f72a530750938d534c42a6c27e9b1c92be", "length": "5329.44", "height": "384", "width": "512"}, {"name": "Broken_Blossoms.ogv", "source": "derivative", "title": "Broken Blossoms", "format": "Ogg Video", "original": "Broken_Blossoms.mp4", "md5": "2269750adb8f3ede445cef8a8fa9184e", "mtime": "1267719249", "size": "339111734", "crc32": "2b0680e5", "sha1": "c411c324ffc1d0dc1384d6a88e94d8a344030937", "length": "5329.44", "height": "304", "width": "400"}, {"name": "Broken_Blossoms_512kb.mp4", "source": "derivative", "title": "Broken Blossoms", "format": "512Kb MPEG4", "original": "Broken_Blossoms.mp4", "md5": "b425563354f755951ec8c98920ae1e2e", "mtime": "1267718193", "size": "342178181", "crc32": "df857895", "sha1": "f1f0cec93daeac4efc66622721d08af60d5e9808", "length": "5329.44", "height": "240", "width": "320"}, {"name": "__ia_thumb.jpg", "source": "original", "mtime": "1539112049", "size": "7643", "md5": "39cd2c4b2f0f7beea9d133b012666a30", "crc32": "72a4e2dc", "sha1": "1e9ebdb47691ce6d99a8cc87f500b6d1a76020b2", "format": "Item Tile", "rotation": "0"}], "files_count": 98, "item_last_updated": 1772749290, "item_size": 1108883598, "metadata": {"identifier": "Broken.Blossoms", "title": "Broken Blossoms", "creator": "D.W. Griffith", "mediatype": "movies", "collection": ["silent_films", "feature_films", "moviesandfilms"], "description": "From <a href=\"http://www.imdb.com/title/tt0009968/\" rel=\"ugc nofollow\">IMDb</a>: Cheng Huan is a missionary whose goal is to bring the teachings of peace by Buddha to the civilized Anglo-Saxons. Upon landing in England, he is quickly disillusioned by the intolerance and apathy of the country. He becomes a storekeeper of a small shop. Out his window, he sees the young Lucy Burrows. She is regularly beaten by her prizefighter father, underfed and wears ragged clothes. Even in this deplorable condition, Cheng can see that she is a priceless beauty and he falls in love with her from afar. On the day that she passes out in front of his store, he takes her in and cares for her. With nothing but love in his heart, he dresses her in silks and provides food for her. Still weak, she stays in his shop that night and all that Cheng does is watch over her. The peace and happiness that he sees last only until Battling Burrows finds out that his daughter is with a foreigner.\n\nStars: Lillian Gish, Richard Barthelmess, and Donald Crisp\n\nThis movie can also be found <a href=\"http://www.archive.org/details/BrokenBlossoms\" rel=\"ugc nofollow\">here</a> and <a href=\"http://www.archive.org/details/brokenblossoms1919\" rel=\"ugc nofollow\">here</a>.", "date": "1919", "year": "1919", "subject": "Romance", "licenseurl": "http://creativecommons.org/licenses/publicdomain/", "publicdate": "2010-03-04 14:38:35", "addeddate": "2010-03-04 14:37:43", "uploader": "bill.barstad@gmail.com", "updater": ["billbarstad", "billbarstad"], "updatedate": ["2010-03-04 14:44:32", "2010-03-11 20:04:00"], "director": "D.W. Griffith", "publisher": "D.W. Griffith Productions", "sound": "Silent, No Music", "color": "Black & White", "runtime": "1:28:49", "language": "English", "backup_location": "ia903604_34", "ia_orig__runtime": "88 minutes, 49 seconds"}, "reviews": [{"reviewbody": "This is a fantastic silent film.I love it so much that I had to buy a copy.It's just a bit of a letdown that it doesn't have the music with it,but other than that,it's fine.1 star less for that reason.", "reviewtitle": "It's too bad theres no music with this", "reviewer": "MaryAnna", "reviewdate": "2010-03-10 08:40:07", "createdate": "2010-03-10 08:40:07", "stars": "4"}, {"reviewbody": "....My Laundry..?", "reviewtitle": "....Where's....", "reviewer": "doowopbob", "reviewdate": "2010-03-14 05:17:53", "createdate": "2010-03-14 05:17:53", "stars": "1"}], "server": "ia803108.us.archive.org", "uniq": 693597872, "workable_servers": ["ia803108.us.archive.org", "ia903108.us.archive.org"]}