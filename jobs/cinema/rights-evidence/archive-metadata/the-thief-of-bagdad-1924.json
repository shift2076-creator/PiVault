05", "size": "5609", "md5": "77d9e750fb63358301e7d15a47db86ba", "crc32": "b6614a10", "sha1": "6151fccd0bf8f020b2c66814830308c289c8e416"}, {"name": "TheThiefOfBagdad1924.thumbs/TOB1924slim_008274.jpg", "source": "derivative", "format": "Thumbnail", "original": "TOB1924slim.mp4", "mtime": "1341302813", "size": "3697", "md5": "e4397e0650d9878763efcf7bd887f474", "crc32": "1cfefa6d", "sha1": "9e3b9f404734dc2d872164b670ca70a98f9e4b37"}, {"name": "TheThiefOfBagdad1924.thumbs/TOB1924slim_008334.jpg", "source": "derivative", "format": "Thumbnail", "original": "TOB1924slim.mp4", "mtime": "1341302820", "size": "3327", "md5": "99f1a872bbfc210b36196a8fc0282cb1", "crc32": "518d7dd7", "sha1": "cdca3326f32fbd93f01399c5cbd5919b95296748"}, {"name": "TheThiefOfBagdad1924.thumbs/TOB1924slim_008394.jpg", "source": "derivative", "format": "Thumbnail", "original": "TOB1924slim.mp4", "mtime": "1341302826", "size": "5556", "md5": "4f9b2121072b7d3045a1930f72d3ba21", "crc32": "9e766006", "sha1": "da1b8e8dc4350c57c937d6d3396177e9b4ddd518"}, {"name": "TheThiefOfBagdad1924_archive.torrent", "source": "metadata", "btih": "d214273b9ea350579bbcc0e183581796a46b596e", "mtime": "1613739799", "size": "27283", "md5": "67e3e3f73e25786e8452e62324256a18", "crc32": "399eacef", "sha1": "a7a2dadf6026c2a1506262d8421e409602e1bccf", "format": "Archive BitTorrent"}, {"name": "TheThiefOfBagdad1924_files.xml", "source": "original", "format": "Metadata", "md5": "de16386507df8140a8d21f889ed23dc3", "summation": "md5"}, {"name": "TheThiefOfBagdad1924_meta.xml", "source": "original", "format": "Metadata", "mtime": "1613739787", "size": "1837", "md5": "56bf2a3b9039a83c6286e228bbdaf0fc", "crc32": "2cd2496d", "sha1": "62ddb3e2c175c609ce36234579df1e140fe4ea61"}, {"name": "TheThiefOfBagdad1924_reviews.xml", "source": "original", "mtime": "1575836814", "size": "777", "md5": "04c3f3e2e7699770e6243ec095463fde", "crc32": "42384c12", "sha1": "2681b1745db412db133660c053527a7c62cb5cc2", "format": "Metadata"}, {"name": "__ia_thumb.jpg", "source": "original", "mtime": "1613739788", "size": "7583", "md5": "25097cd091b5fb09ed72ed22a7aa04a2", "crc32": "c4e6dade", "sha1": "4857c66636240e6beeb2173912f0f204ae099141", "format": "Item Tile", "rotation": "0"}], "files_count": 149, "item_last_updated": 1613739800, "item_size": 1325771914, "metadata": {"mediatype": "movies", "collection": ["opensource_movies", "community"], "title": "The Thief of Bagdad (1924)", "description": "The Thief of Bagdad is a 1924 American swashbuckler film directed by Raoul Walsh and starring Douglas Fairbanks. Freely adapted from One Thousand and One Nights, it tells the story of a thief who falls in love with the daughter of the Caliph of Bagdad. In 1996, the film was selected for preservation in the United States National Film Registry by the Library of Congress as being \"culturally, historically, or aesthetically significant\". [1]\nFairbanks considered this to be his personal favorite of all of his films, according to his son. The film's use of imaginative gymnastics fit the athletic star, his \"catlike, seemingly effortless\" movements were as much dance as gymnastics.[2] Along with his earlier Robin Hood (1922), the film marked Fairbanks's transformation from genial comedy to a career in \"swashbuckling\" roles.[3] The movie, strong on special effects of the period (flying carpet, magic rope and fearsome monsters) and featuring massive Arabian-style sets, also proved to be a stepping stone for Anna May Wong, who portrayed a treacherous Mongol slave.", "subject": "Douglas Fairbanks; Silent; Fantasy; Arabian Nights", "licenseurl": "http://creativecommons.org/publicdomain/mark/1.0/", "identifier": "TheThiefOfBagdad1924", "uploader": "chris@condon.net", "addeddate": "2012-07-03 04:08:10", "publicdate": "2012-07-03 07:26:55", "curation": "[curator]malware@archive.org[/curator][date]20140322220518[/date][comment]checked for malware[/comment]", "backup_location": "ia903806_4"}, "reviews": [{"reviewbody": "Thanks for the upload! I found it really impressive for the time. The performances are fun to watch and although the pacing is a bit slow in the beginning, I'd still highly recommend watching it. \nHere's my review: http://max4movies.blog/2019/12/08/the-thief-of-bagdad-us-1924/", "reviewtitle": "Epic and Entertaining Classic", "reviewer": "MSeitz", "reviewer_itemname": "@mseitz", "reviewdate": "2019-12-08 20:26:50", "createdate": "2019-12-08 20:26:50", "stars": "4"}], "server": "dn601202.us.archive.org", "simplelists": {"solo_manifest": {"solo_manifest_dn601202": {"sys_changed_by": {"source": "task", "task_id": "5458475635"}, "sys_last_changed": "2026-06-22 10:13:20.421375"}}}, "solo": true, "uniq": 1800846697, "workable_servers": ["dn601202.us.archive.org"]}